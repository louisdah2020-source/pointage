# MySQL source (only needed for the one-time legacy data migration)
MYSQL_HOST=localhost
MYSQL_DBNAME=your_database
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password

# Supabase target
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_key

# Vercel scheduled attendance reports (all cron schedules use UTC)
CRON_SECRET=generate_a_long_random_secret
MAIL_ENDPOINT_URL=https://your-php-host.example/send_mail.php
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
ADMIN_DELETE_PASSWORD=generate_a_long_random_password

# Data range to migrate
FROM_DATE=2026-09-01
